{
    "name": "jonathan8312/siigo-laravel",
    "description": "Community Laravel SDK for the public Siigo API",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "siigo",
        "dian",
        "colombia",
        "electronic-invoicing",
        "facturacion-electronica"
    ],
    "authors": [
        {
            "name": "Jonathan Torres",
            "email": "jt@jonathant.dev",
            "homepage": "https://trebolcolombia.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5.50|^12.5.8|^13.0.0",
        "phpstan/phpstan": "^2.2",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "Jonathan8312\\Siigo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jonathan8312\\Siigo\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testsuite=Unit,Feature",
        "test:staging": "phpunit --testsuite=Staging",
        "analyse": "phpstan analyse",
        "format": "pint",
        "format:test": "pint --test"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Jonathan8312\\Siigo\\SiigoServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
