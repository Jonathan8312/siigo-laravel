# Copia este archivo a .env.staging.local y completa con credenciales reales
# de un ambiente de pruebas de Siigo API. Nunca commitees .env.staging.local.

# SIIGO_PARTNER_ID debe ser estrictamente alfanumérico (sin guiones, espacios ni
# caracteres especiales) y representar el nombre real de tu integración.
SIIGO_USERNAME=
SIIGO_ACCESS_KEY=
SIIGO_PARTNER_ID=YourCompanyName
